{
  "schema_version": "1.3.0",
  "description": "Example local manifest for collecting authorized Arkheionx JSON reports. Do not include private code or secrets.",
  "repos": [
    {
      "repo_alias": "Repo Alpha",
      "report_json_path": "../repo-alpha/reports/arkheionx-report.json",
      "protocol_type": "staking",
      "public_summary_allowed": false,
      "notes": "Authorized local report path only."
    },
    {
      "repo_alias": "Repo Beta",
      "report_json_path": "../repo-beta/reports/arkheionx-report.json",
      "protocol_type": "vault",
      "public_summary_allowed": false,
      "notes": "Use aliases unless public naming permission exists."
    }
  ]
}
