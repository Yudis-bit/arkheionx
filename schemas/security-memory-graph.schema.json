{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yudis-bit/DeFi-Exploit-PoCs/schemas/security-memory-graph.schema.json",
  "title": "Arkheionx Security Memory Graph",
  "type": "object",
  "required": ["schema_version", "description", "nodes", "edges"],
  "properties": {
    "schema_version": { "type": "string" },
    "description": { "type": "string" },
    "generated_at": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "edges": { "type": "array" }
  },
  "additionalProperties": true
}
