{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Scope-Aware Tasks",
  "description": "Local/static testable tasks derived from scope-aware lanes. Tasks are research instructions, not findings and not exploit instructions. Human review required.",
  "type": "object",
  "required": [
    "schema_version", "arkheionx_version", "kind", "scope_file_used",
    "tasks", "lanes", "report_filters", "human_review_required", "safety_boundary", "safety"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "arkheionx_version": {"type": "string"},
    "kind": {"type": "string", "enum": ["scope-tasks"]},
    "command": {"type": "string"},
    "generated_at": {"type": "string"},
    "scope_file_used": {"type": "boolean"},
    "repo_summary": {"type": "object"},
    "task_count": {"type": "integer"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "lane_id", "title", "target", "hypothesis", "counterfactual",
                     "validity_filter", "known_issue_filter", "required_assertions",
                     "required_evidence", "stop_condition", "kill_condition", "report_candidate_threshold",
                     "human_review_required"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3}$"},
          "lane_id": {"type": "string", "pattern": "^LANE-[0-9]{2}$"},
          "lane_name": {"type": "string"},
          "category": {"type": "string"},
          "task_type": {"type": "string"},
          "priority": {"type": "string", "enum": ["very-high", "high", "medium", "monitor"]},
          "target": {"type": "string"},
          "target_contract": {"type": "string"},
          "target_function": {"type": "string"},
          "source_reference": {"type": "string"},
          "title": {"type": "string"},
          "hypothesis": {"type": "string"},
          "counterfactual": {"type": "string"},
          "why_it_might_matter": {"type": "string"},
          "validity_filter": {"type": "string"},
          "known_issue_filter": {"type": "string"},
          "setup": {"type": "string"},
          "action": {"type": "string"},
          "required_assertions": {"type": "array", "items": {"type": "string"}},
          "required_evidence": {"type": "array", "items": {"type": "string"}},
          "likely_invalid_conditions": {"type": "array", "items": {"type": "string"}},
          "stop_condition": {"type": "string"},
          "kill_condition": {"type": "string"},
          "report_candidate_threshold": {"type": "string"},
          "human_review_required": {"type": "boolean", "enum": [true]}
        }
      }
    },
    "lanes": {"type": "array", "items": {"type": "object"}},
    "report_filters": {"type": "object"},
    "human_review_required": {"type": "boolean", "enum": [true]},
    "safety_boundary": {"type": "string"},
    "safety": {"type": "object", "required": ["boundary", "human_review_required"]}
  }
}
