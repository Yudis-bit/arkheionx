{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Review Map Test Gaps",
  "description": "Suggested local test scenarios for value-sensitive functions. Review guidance, not coverage proof.",
  "type": "object",
  "required": ["schema_version", "generated_at", "test_gaps"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "repo_path": {"type": "string"},
    "test_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "related_function", "confidence", "evidence_level", "status"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "related_function": {"type": "string"},
          "related_value_path": {"type": "string"},
          "suggested_test": {"type": "string"},
          "rationale": {"type": "string"},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence_level": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    }
  }
}
