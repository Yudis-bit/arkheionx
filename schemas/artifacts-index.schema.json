{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Artifacts Index",
  "type": "object",
  "required": ["schema_version", "generated_at", "project_root", "targets"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "project_root": {"type": "string"},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "slug", "status", "evidence_level", "review_status"],
        "properties": {
          "target": {"type": "string"},
          "slug": {"type": "string"},
          "proof_json": {"type": "string"},
          "trace_json": {"type": "string"},
          "evidence_json": {"type": "string"},
          "report_json": {"type": "string"},
          "status": {"type": "string"},
          "evidence_level": {"type": "string"},
          "review_status": {"type": "string", "enum": ["NO_PROOF", "PROOF_ONLY", "TRACE_READY", "EVIDENCE_READY", "REPORT_DRAFTED"]},
          "malformed": {"type": "array", "items": {"type": "string"}},
          "updated_at": {"type": "string"}
        }
      }
    }
  }
}
