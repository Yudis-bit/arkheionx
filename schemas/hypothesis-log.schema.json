{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Hypothesis Log",
  "description": "A structured hypothesis log / rejected-finding memory. ArkheionX emits every hypothesis at status 'open' with empty tracking fields; a human or an agent under human review fills them in after local tests. Hypotheses are review prompts, not vulnerabilities; rejected hypotheses are useful evidence.",
  "type": "object",
  "required": ["schema_version", "kind", "generated_at", "summary", "notes", "hypotheses"],
  "properties": {
    "schema_version": {"type": "string"},
    "kind": {"type": "string", "enum": ["hypothesis-log"]},
    "generated_at": {"type": "string"},
    "repo_path": {"type": "string"},
    "mode": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["total", "statuses", "by_status", "by_bug_class"],
      "properties": {
        "total": {"type": "integer"},
        "statuses": {"type": "array", "items": {"type": "string"}},
        "by_status": {"type": "object"},
        "by_bug_class": {"type": "object"}
      }
    },
    "notes": {
      "type": "object",
      "required": ["rejected_findings_are_evidence", "how_to_fill"],
      "properties": {
        "rejected_findings_are_evidence": {"type": "string"},
        "how_to_fill": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "surface", "bug_class", "suggested_local_test", "evidence_required", "test_command", "result", "rejection_reason", "confirmation_notes", "human_decision", "manual_review_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^HYP-[0-9]{3}$"},
          "status": {"type": "string", "enum": ["open", "testing", "rejected", "confirmed", "needs-human-review"]},
          "surface": {"type": "string"},
          "contract": {"type": "string"},
          "function": {"type": "string"},
          "target": {"type": "string"},
          "source": {"type": "string"},
          "value_path": {"type": "string"},
          "bug_class": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "suggested_local_test": {"type": "string"},
          "evidence_required": {"type": "string"},
          "related_test_gap": {"type": "string"},
          "manual_review_required": {"type": "boolean"},
          "test_command": {"type": "string"},
          "result": {"type": "string"},
          "rejection_reason": {"type": "string"},
          "confirmation_notes": {"type": "string"},
          "human_decision": {"type": "string"}
        }
      }
    }
  }
}
