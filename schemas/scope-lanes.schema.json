{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Scope-Aware Review Lanes",
  "description": "Local/static review lanes selected for a scope. Lanes are planning artifacts, not findings. Priority is review order, not severity. Human review required.",
  "type": "object",
  "required": [
    "schema_version", "arkheionx_version", "kind", "scope_file_used",
    "lanes", "priorities", "filters", "human_review_required", "safety_boundary", "safety"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "arkheionx_version": {"type": "string"},
    "kind": {"type": "string", "enum": ["scope-lanes"]},
    "command": {"type": "string"},
    "generated_at": {"type": "string"},
    "scope_file_used": {"type": "boolean"},
    "repo_summary": {"type": "object"},
    "lane_count": {"type": "integer"},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_id", "lane_name", "priority", "why_it_matters",
                     "evidence_required", "stop_conditions", "human_review_required"],
        "properties": {
          "lane_id": {"type": "string", "pattern": "^LANE-[0-9]{2}$"},
          "lane_name": {"type": "string"},
          "slug": {"type": "string"},
          "priority": {"type": "string", "enum": ["very-high", "high", "medium", "monitor"]},
          "scope": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "target_files_functions": {"type": "array", "items": {"type": "string"}},
          "surface_count": {"type": "integer"},
          "relevant_assumptions": {"type": "array", "items": {"type": "string"}},
          "known_accepted_filters": {"type": "array", "items": {"type": "string"}},
          "high_impact_hypothesis_directions": {"type": "array", "items": {"type": "string"}},
          "what_can_be_valid": {"type": "string"},
          "what_is_likely_invalid": {"type": "string"},
          "evidence_required": {"type": "array", "items": {"type": "string"}},
          "stop_conditions": {"type": "array", "items": {"type": "string"}},
          "invalid_conditions": {"type": "array", "items": {"type": "string"}},
          "human_review_required": {"type": "boolean", "enum": [true]}
        }
      }
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_id", "priority"],
        "properties": {
          "lane_id": {"type": "string"},
          "lane_name": {"type": "string"},
          "priority": {"type": "string", "enum": ["very-high", "high", "medium", "monitor"]}
        }
      }
    },
    "filters": {"type": "object"},
    "human_review_required": {"type": "boolean", "enum": [true]},
    "safety_boundary": {"type": "string"},
    "safety": {"type": "object", "required": ["boundary", "human_review_required"]}
  }
}
