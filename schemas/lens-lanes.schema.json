{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Protocol Lens Review Lanes",
  "description": "Protocol-aware review lanes for a lens (v7.5). Lane priority is review order, not severity. A review lane is not a vulnerability. Human review required.",
  "type": "object",
  "required": [
    "schema_version", "lens_layer", "arkheionx_version", "kind", "command",
    "lens", "generated_at", "scope_file_used", "scope_status",
    "lane_count", "lanes", "human_review_required", "safety_boundary", "safety"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "lens_layer": {"type": "string"},
    "arkheionx_version": {"type": "string"},
    "kind": {"type": "string", "enum": ["lens-lanes"]},
    "command": {"type": "string", "enum": ["lens-lanes"]},
    "lens": {
      "type": "object",
      "required": ["lens_id", "display_name"],
      "properties": {
        "lens_id": {"type": "string"},
        "display_name": {"type": "string"}
      }
    },
    "generated_at": {"type": "string"},
    "scope_file_used": {"type": "boolean"},
    "scope_status": {"type": "string"},
    "lane_count": {"type": "integer"},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "priority": {"type": "string"},
          "invariants_at_risk": {"type": "array", "items": {"type": "string"}},
          "promises_at_risk": {"type": "array", "items": {"type": "string"}},
          "human_review_required": {"type": "boolean"}
        }
      }
    },
    "mandatory_lane_ids": {"type": "array", "items": {"type": "string"}},
    "priorities": {"type": "array"},
    "filters": {"type": "object"},
    "human_review_required": {"type": "boolean", "enum": [true]},
    "safety_boundary": {"type": "string"},
    "safety": {"type": "object"}
  }
}
