{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Protocol Lens Evidence Map",
  "description": "Per-invariant local-test evidence classification for a lens (v7.5). Evidence quality is not vulnerability validity. Human review required.",
  "type": "object",
  "required": [
    "schema_version", "lens_layer", "arkheionx_version", "kind", "command",
    "lens", "generated_at", "scope_file_used", "scope_status",
    "evidence_statuses", "items", "counts", "summary",
    "human_review_required", "safety_boundary", "safety"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "lens_layer": {"type": "string"},
    "arkheionx_version": {"type": "string"},
    "kind": {"type": "string", "enum": ["lens-evidence"]},
    "command": {"type": "string", "enum": ["lens-evidence"]},
    "lens": {
      "type": "object",
      "required": ["lens_id", "display_name"],
      "properties": {
        "lens_id": {"type": "string"},
        "display_name": {"type": "string"}
      }
    },
    "generated_at": {"type": "string"},
    "scope_file_used": {"type": "boolean"},
    "scope_status": {"type": "string"},
    "evidence_statuses": {"type": "array", "items": {"type": "string"}},
    "test_files_scanned": {"type": "integer"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["invariant_id", "status"],
        "properties": {
          "invariant_id": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "counts": {"type": "object"},
    "summary": {"type": "object"},
    "rules": {"type": "array"},
    "human_review_required": {"type": "boolean", "enum": [true]},
    "safety_boundary": {"type": "string"},
    "safety": {"type": "object"}
  }
}
