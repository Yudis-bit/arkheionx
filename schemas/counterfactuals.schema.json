{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Counterfactual Research Plan",
  "description": "Local/static counterfactual research prompts generated by negating guarding assumptions. Counterfactuals are research prompts, not findings; each carries a local test direction, evidence required, and a stop condition. Human review is required.",
  "type": "object",
  "required": ["schema_version", "kind", "repository", "counterfactuals", "counterfactual_matrix", "assumptions", "safety"],
  "properties": {
    "schema_version": {"type": "string"},
    "kind": {"type": "string", "enum": ["counterfactuals"]},
    "generated_at": {"type": "string"},
    "repo_path": {"type": "string"},
    "mode": {"type": "string"},
    "repository": {
      "type": "object",
      "required": ["repo_path", "mode", "contracts", "functions"],
      "properties": {
        "repo_path": {"type": "string"},
        "mode": {"type": "string"},
        "contracts": {"type": "integer"},
        "functions": {"type": "integer"}
      }
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assumption", "topic", "what_if_false", "why_it_could_matter", "local_test_direction", "evidence_needed", "stop_condition", "impact_potential", "testability", "priority", "status", "manual_review_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^CF-[0-9]{3}$"},
          "assumption": {"type": "string"},
          "topic": {"type": "string"},
          "surface": {"type": "string"},
          "contract": {"type": "string"},
          "function": {"type": "string"},
          "target": {"type": "string"},
          "source": {"type": "string"},
          "what_if_false": {"type": "string"},
          "why_it_could_matter": {"type": "string"},
          "impact_potential": {"type": "string", "enum": ["very-high", "high", "medium", "low", "unknown"]},
          "testability": {"type": "string", "enum": ["high", "medium", "low"]},
          "priority": {"type": "string", "enum": ["very-high", "high", "medium", "monitor"]},
          "local_test_direction": {"type": "string"},
          "evidence_needed": {"type": "string"},
          "stop_condition": {"type": "string"},
          "do_not_claim": {"type": "string"},
          "status": {"type": "string", "enum": ["open", "testing", "rejected", "confirmed", "needs-human-review"]},
          "manual_review_required": {"type": "boolean"}
        }
      }
    },
    "counterfactual_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assumption", "false_world_scenario", "impact_potential", "testability", "priority", "evidence_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^CF-[0-9]{3}$"},
          "assumption": {"type": "string"},
          "false_world_scenario": {"type": "string"},
          "impact_potential": {"type": "string", "enum": ["very-high", "high", "medium", "low", "unknown"]},
          "testability": {"type": "string", "enum": ["high", "medium", "low"]},
          "priority": {"type": "string", "enum": ["very-high", "high", "medium", "monitor"]},
          "evidence_required": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "safety": {
      "type": "object",
      "required": ["disclaimer", "boundary", "human_review_required"],
      "properties": {
        "disclaimer": {"type": "string"},
        "boundary": {"type": "array", "items": {"type": "string"}},
        "do_not_claim": {"type": "array", "items": {"type": "string"}},
        "human_review_required": {"type": "boolean"}
      }
    }
  }
}
