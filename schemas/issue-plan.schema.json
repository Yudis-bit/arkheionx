{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yudis-bit/DeFi-Exploit-PoCs/schemas/issue-plan.schema.json",
  "title": "Arkheionx Issue Plan",
  "type": "object",
  "required": ["tool", "version", "schema_version", "generated_at", "repo_root", "protocol_type", "score", "issues", "summary_issue", "disclaimer"],
  "properties": {
    "tool": { "const": "Arkheionx Pre-Audit Scanner" },
    "version": { "type": "string" },
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "repo_root": { "type": "string" },
    "protocol_type": { "type": "string" },
    "score": { "type": "integer" },
    "fix_first": { "type": "array" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["marker", "finding_id", "title", "labels", "body", "priority", "confidence"],
        "properties": {
          "marker": { "type": "string" },
          "finding_id": { "type": "string" },
          "title": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "body": { "type": "string" },
          "priority": { "type": "string" },
          "confidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "summary_issue": { "type": "object" },
    "disclaimer": { "type": "string" }
  },
  "additionalProperties": true
}
