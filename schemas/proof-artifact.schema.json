{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkheionx Proof Artifact",
  "type": "object",
  "required": ["target_id", "status", "evidence_level", "files"],
  "properties": {
    "target_id": {"type": "string"},
    "status": {"type": "string"},
    "foundry_available": {"type": "boolean"},
    "build_status": {"type": "string"},
    "tests_generated": {"type": "integer"},
    "tests_run": {"type": "integer"},
    "tests_passed": {"type": "integer"},
    "tests_failed": {"type": "integer"},
    "trace_summary": {"type": "string"},
    "evidence_level": {"type": "string", "enum": ["HEURISTIC", "COMPILER_CONFIRMED", "EXECUTION_CONFIRMED", "REPORT_READY"]},
    "files": {"type": "array", "items": {"type": "string"}},
    "remaining_manual": {"type": "array", "items": {"type": "string"}}
  }
}
