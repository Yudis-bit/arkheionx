---
import Layout from "../components/Layout.astro";

const available = [
  "v4.0.0 git tag",
  "Published GitHub release",
  "Source installer endpoint",
  "Manual GitHub install path",
  "Local-first review workflow documentation"
];

const notYet = [
  "Prebuilt binaries",
  "Signed checksums",
  "Package registry (PyPI) release",
  "Versioned installer channels"
];
---

<Layout
  title="Releases — ArkheionX"
  description="ArkheionX release status: v4.0.0 is the current release, installed from source. Binary and registry distribution come later."
>
  <main class="releases-page">
    <section class="releases-hero">
      <p class="releases-kicker">Releases</p>
      <h1>v4.0.0 is the current release. Install from source.</h1>
      <p>
        v4.0.0 is tagged in git with a published GitHub release, and the site is live. The current
        distribution model is source-first; prebuilt binaries, signed checksums, and a package
        registry release come after further release-pipeline hardening.
      </p>
    </section>

    <section class="releases-install">
      <div>
        <p class="releases-kicker">Current install path</p>
        <h2>Install from public source.</h2>
      </div>
      <div>
        <pre><code>curl -fsSL https://arkheionx.dev/install.sh | bash</code></pre>
      </div>
    </section>

    <section class="releases-columns">
      <article>
        <span>Available</span>
        <h2>Current public surface</h2>
        <ul>{available.map((item) => <li>{item}</li>)}</ul>
      </article>

      <article>
        <span>Not yet available</span>
        <h2>Future release work</h2>
        <ul>{notYet.map((item) => <li>{item}</li>)}</ul>
      </article>
    </section>

    <section class="releases-section">
      <div>
        <p class="releases-kicker">Release discipline</p>
        <h2>Do not publish before validation.</h2>
      </div>
      <div class="releases-card">
        <p>
          A public release should only be promoted after fresh source install validation, release
          readiness checks, docs checks, safety wording checks, and the full test suite pass.
        </p>
      </div>
    </section>

    <section class="releases-boundary">
      <p class="releases-kicker">Boundary</p>
      <h2>A release is not an audit result.</h2>
      <p>
        Publishing software does not mean ArkheionX confirms vulnerabilities, proves protocol
        safety, or stands in for human security review.
      </p>
    </section>
  </main>
</Layout>
