---
import Layout from "../components/Layout.astro";

const links = [
  ["/", "Home", "The review-map overview and demo."],
  ["/docs/quickstart", "Quickstart", "Run the demo in five minutes."],
  ["/docs/cli-reference", "Command reference", "Every command, with exit codes."],
  ["/docs/bug-bounty", "Bug bounty workflow", "Safe triage and hypothesis generation."],
  ["/docs/how-it-works", "How it works", "The review-map pipeline."],
  ["/examples", "Examples", "The bundled multi-contract demo."],
  ["/install", "Install", "Source install and verification."]
];
---

<Layout
  title="Page not found — ArkheionX"
  description="The page you requested could not be found. Jump to the ArkheionX quickstart, command reference, or demo."
>
  <main class="workflow-page">
    <section class="workflow-hero">
      <p class="workflow-kicker">404 · Page not found</p>
      <h1>That page is not here.</h1>
      <p>
        The route may have moved, or the address may have a small typo (for example,
        <code>/docs/bug-bounty</code> rather than <code>/docs/bugbounty</code>). Use the links
        below to get back on track.
      </p>
    </section>

    <section class="cli-table" aria-label="Where to go next">
      {links.map((item) => (
        <article>
          <div>
            <h2>{item[1]}</h2>
            <pre><code>{item[0]}</code></pre>
          </div>
          <div>
            <h3>Go to</h3>
            <p><a class="text-link" href={item[0]}>{item[1]}</a></p>
            <h3>What it is</h3>
            <p>{item[2]}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="workflow-command cli-section--split">
      <div>
        <p class="workflow-kicker">Try the demo</p>
        <h2>One command builds a review map.</h2>
        <p>Run this from a local checkout to see real output.</p>
      </div>
      <div class="workflow-command__stack">
        <pre><code>arkheionx review-map examples/vault-strategy-oracle-fixture</code></pre>
      </div>
    </section>

    <section class="workflow-boundary">
      <p class="workflow-kicker">Safety</p>
      <h2>Local/static only.</h2>
      <p>
        No RPC. No live-chain calls. No exploit automation. Human review required. ArkheionX
        organizes review context; it does not confirm vulnerabilities or assign final severity.
      </p>
      <a href="/docs/safety-model" class="workflow-button">Read the safety model</a>
    </section>
  </main>
</Layout>
