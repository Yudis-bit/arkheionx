---
import Layout from "../components/Layout.astro";

const workflow = [
  ["Scope", "Start from the actual review rules."],
  ["Value flow", "Map where assets enter, move, and exit."],
  ["Protocol behavior", "Capture the promises the system appears to rely on."],
  ["Review lanes", "Prioritize where a human should inspect first."],
  ["Evidence tasks", "Turn hypotheses into local tests with kill conditions."],
  ["Evidence judge", "Check whether local proof actually supports the claim."],
  ["Report filter", "Block weak, out-of-scope, or under-proven candidates."]
];

const outputs = [
  ["Scope map", "What is in and out of scope, read from the scope note."],
  ["Value-flow map", "Where assets enter, move, and exit the system."],
  ["Interaction map", "How contracts and roles touch each other."],
  ["Review lanes", "A prioritized order for a human to inspect."],
  ["Evidence tasks", "Local test ideas, each with a kill condition."],
  ["Protocol model", "Behavior promises captured as review context."],
  ["Invariants", "The economic conditions expected to hold."],
  ["Evidence rubric", "How to grade whether a test proves its task."],
  ["Report filter", "A gate for weak or out-of-scope candidates."],
  ["Agent input", "A model-agnostic brief for AI-assisted review."]
];

const safety = [
  ["Planning, not verdicts", "Review lanes are not findings."],
  ["Local-first", "No RPC or live-chain scanning by default."],
  ["Evidence-first", "Candidates need local proof before report writing."],
  ["Human review required", "Arkheionx does not submit reports or assign final severity."]
];

const repo = "https://github.com/Yudis-bit/DeFi-Exploit-PoCs";
---

<Layout
  title="Arkheionx — Local-first security research workflow for Solidity and DeFi"
  description="Arkheionx turns scope, value flow, protocol behavior, invariants, and local evidence into focused review lanes before report writing. No RPC. No live-chain scanning. Human review required."
>
  <main class="home">
    <!-- 1. Hero -->
    <section class="hero">
      <p class="eyebrow">Local-first · Solidity &amp; DeFi</p>
      <h1>Local-first security research workflow for Solidity and DeFi repos.</h1>
      <p class="lede">
        Arkheionx turns scope, value flow, protocol behavior, invariants, and local evidence
        into focused review lanes before report writing.
      </p>
      <p class="boundary">No RPC. No live-chain scanning. No auto-submit. Human review required.</p>

      <div class="actions">
        <a class="btn btn-primary" href="/docs">Read docs</a>
        <a class="btn" href={repo} target="_blank" rel="noreferrer">View GitHub</a>
      </div>

      <div class="term" aria-label="Primary command">
        <span class="term-dot" aria-hidden="true"></span>
        <pre><code>arkheionx review . --scope-file scope.md</code></pre>
      </div>
    </section>

    <!-- 2. Problem -->
    <section class="band">
      <p class="kicker">The problem</p>
      <div class="prose">
        <p>Large Solidity repositories are easy to review randomly.</p>
        <p>
          Arkheionx gives the review a structure before anyone writes a finding: what is in
          scope, where value moves, which assumptions matter, and what local evidence is still
          missing.
        </p>
      </div>
    </section>

    <!-- 3. Workflow -->
    <section class="band">
      <p class="kicker">Workflow</p>
      <h2>One repository becomes a structured review.</h2>
      <ol class="flow">
        {workflow.map((step, i) => (
          <li>
            <span class="flow-index">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{step[0]}</h3>
              <p>{step[1]}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4. CLI example -->
    <section class="band">
      <p class="kicker">One command</p>
      <h2>Build a local review pack.</h2>
      <p class="prose">
        The review command writes a local review pack with Markdown for humans and JSON for tools.
      </p>
      <div class="term term-block">
        <pre><code>arkheionx review . --scope-file scope.md --out .arkheionx/review</code></pre>
      </div>
      <p class="prose muted-note">Add a protocol lens for a protocol-aware deep dive:</p>
      <div class="term term-block">
        <pre><code>arkheionx review . --scope-file scope.md --lens fixed-credit-market --out .arkheionx/review</code></pre>
      </div>
      <p class="prose muted-note">Install from source:</p>
      <div class="term term-block">
        <pre><code>curl -fsSL https://arkheionx.dev/install.sh | bash</code></pre>
      </div>
    </section>

    <!-- 5. Outputs -->
    <section class="band">
      <p class="kicker">Outputs</p>
      <h2>What the review pack contains.</h2>
      <div class="outputs">
        {outputs.map((item) => (
          <article>
            <h3>{item[0]}</h3>
            <p>{item[1]}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 6. Safety boundary -->
    <section class="band">
      <p class="kicker">Safety boundary</p>
      <h2>Arkheionx does not decide whether something is a vulnerability.</h2>
      <p class="prose">
        It helps structure review evidence before a human makes that call.
        It does not confirm vulnerabilities, and it does not assign final severity.
      </p>
      <div class="safety">
        {safety.map((card) => (
          <article>
            <h3>{card[0]}</h3>
            <p>{card[1]}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 7. Final CTA -->
    <section class="cta">
      <h2>Start with one local review pack.</h2>
      <div class="actions">
        <a class="btn btn-primary" href="/docs">Read the docs</a>
        <a class="btn" href={repo} target="_blank" rel="noreferrer">Open GitHub</a>
      </div>
      <div class="term term-block">
        <pre><code>arkheionx review . --scope-file scope.md</code></pre>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home {
    --accent: var(--amber);
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  .eyebrow,
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }

  /* 1. Hero */
  .hero {
    padding: 104px 0 88px;
    max-width: 820px;
  }

  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    font-weight: 600;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 680px;
    margin: 0 0 20px;
  }

  .boundary {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--muted);
    border-left: 2px solid var(--accent);
    padding-left: 14px;
    margin: 0 0 32px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 36px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-bright);
    border-radius: 8px;
    padding: 11px 20px;
    font-size: 0.95rem;
    color: var(--text);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #0a0d12;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: #f6c074;
    color: #0a0d12;
  }

  /* Terminal pills / blocks */
  .term {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    max-width: 720px;
    overflow-x: auto;
  }

  .term-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    flex: none;
  }

  .term pre {
    margin: 0;
  }

  .term code {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--text);
    white-space: pre;
  }

  .term-block {
    margin: 14px 0 0;
  }

  /* Section bands */
  .band {
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }

  .band h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 28px;
    font-weight: 600;
    max-width: 720px;
  }

  .prose {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .prose p {
    margin: 0 0 14px;
  }

  .prose.muted-note {
    font-size: 0.95rem;
    margin: 24px 0 0;
  }

  /* 3. Workflow */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 760px;
  }

  .flow li {
    display: flex;
    gap: 22px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .flow li:first-child {
    border-top: none;
  }

  .flow-index {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    flex: none;
    width: 28px;
  }

  .flow h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .flow p {
    margin: 0;
    color: var(--muted);
  }

  /* 5. Outputs */
  .outputs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }

  .outputs article {
    background: var(--panel);
    padding: 20px;
  }

  .outputs h3 {
    margin: 0 0 6px;
    font-size: 0.98rem;
    font-weight: 600;
  }

  .outputs p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* 6. Safety */
  .safety {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .safety article {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
  }

  .safety h3 {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 600;
  }

  .safety p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* 7. CTA */
  .cta {
    margin-top: 64px;
    padding: 56px 40px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 28px;
    font-weight: 600;
  }

  .cta .actions {
    justify-content: center;
  }

  .cta .term {
    margin: 8px auto 0;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 72px 0 56px;
    }
    .flow li {
      gap: 14px;
    }
  }
</style>
