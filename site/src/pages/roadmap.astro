---
import Layout from "../components/Layout.astro";

const nearTerm = [
  "Keep the docs surface small and navigable.",
  "Document repository identity migration clearly.",
  "Collect external reviewer feedback.",
  "Collect protocol-team feedback.",
  "Publish only evidence-backed case studies."
];

const validation = [
  "Run ArkheionX on established DeFi protocols with authorization.",
  "Record what outputs were useful, noisy, missing, or unsafe.",
  "Turn real review workflows into case studies.",
  "Keep accepted findings separate from submitted or unaccepted issues.",
  "Use external feedback to reduce review noise."
];

const deferred = [
  "Hosted dashboard.",
  "Prebuilt binary release artifacts.",
  "Package registry distribution.",
  "Signed checksums and versioned release channels.",
  "Optional integrations with external analysis tools.",
  "Broad support or grant claims before validation."
];

const nonGoals = [
  "Automatic vulnerability confirmation.",
  "Replacing auditors or security researchers.",
  "Assigning final severity.",
  "Submitting bounty reports automatically.",
  "Running live-chain actions by default.",
  "Claiming ecosystem endorsement."
];
---

<Layout
  title="Roadmap — ArkheionX"
  description="Public ArkheionX roadmap for source distribution, documentation, fixture harness, and review infrastructure."
>
  <main class="roadmap-page">
    <section class="roadmap-hero">
      <p class="roadmap-kicker">Roadmap</p>
      <h1>Public roadmap without false maturity.</h1>
      <p>
        ArkheionX is being built as local-first review infrastructure for smart contract security.
        This roadmap describes direction, not guaranteed delivery dates.
      </p>
    </section>

    <section class="roadmap-current">
      <div>
        <p class="roadmap-kicker">Current public state</p>
        <h2>Source-first and public-safe.</h2>
      </div>
      <div class="roadmap-current__card">
        <p>
          The current priority is credibility: real protocol usage, external reviewer feedback,
          case studies, and a clean repository identity. Feature expansion is secondary.
        </p>
      </div>
    </section>

    <section class="roadmap-grid">
      <article>
        <span>Near-term</span>
        <h2>Credibility and docs hardening</h2>
        <ul>{nearTerm.map((item) => <li>{item}</li>)}</ul>
      </article>

      <article>
        <span>Validation</span>
        <h2>Real review feedback</h2>
        <ul>{validation.map((item) => <li>{item}</li>)}</ul>
      </article>

      <article>
        <span>Deferred</span>
        <h2>After source install is reliable</h2>
        <ul>{deferred.map((item) => <li>{item}</li>)}</ul>
      </article>

      <article>
        <span>Non-goals</span>
        <h2>What ArkheionX should not claim</h2>
        <ul>{nonGoals.map((item) => <li>{item}</li>)}</ul>
      </article>
    </section>

    <section class="roadmap-boundary">
      <p class="roadmap-kicker">Boundary</p>
      <h2>No date promises. No audit promises.</h2>
      <p>
        Roadmap items are directional. ArkheionX does not claim to confirm vulnerabilities, prove
        protocol safety, or stand in for human review.
      </p>
    </section>
  </main>
</Layout>
