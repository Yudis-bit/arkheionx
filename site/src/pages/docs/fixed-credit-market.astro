---
import Layout from "../../components/Layout.astro";

const models = [
  ["Fixed maturity", "Positions that mature or settle at a fixed time."],
  ["Credit and debt units", "How the protocol accounts for what is owed and owned."],
  ["Settlement", "How positions close and value is distributed."],
  ["Group exposure", "Shared risk across positions or markets."],
  ["Bad debt", "What happens when collateral cannot cover debt."],
  ["Gates and fees", "Access conditions and the fees on each path."]
];
---

<Layout
  title="Fixed Credit Market lens — Arkheionx"
  description="The Fixed Credit Market lens is the first generic protocol-family lens for Arkheionx. It models a protocol family, not a specific deployment. Human review required."
>
  <main class="workflow-page">
    <section class="workflow-hero">
      <p class="workflow-kicker">Protocol-aware review</p>
      <h1>The first generic protocol-family lens.</h1>
      <p>
        The Fixed Credit Market lens models a fixed-maturity credit market as a protocol family:
        credit and debt units, settlement, group exposure, bad debt, gates, fees, and periphery
        bundles. It describes a family of designs, not a specific deployment.
      </p>
    </section>

    <section class="workflow-command">
      <div>
        <p class="workflow-kicker">Run it</p>
        <h2>Build a lens pack.</h2>
      </div>
      <div class="workflow-command__stack">
        <pre><code>arkheionx lens-pack . --scope-file scope.md --lens fixed-credit-market</code></pre>
      </div>
    </section>

    <section class="workflow-steps">
      {models.map((item) => (
        <article>
          <span>+</span>
          <h2>{item[0]}</h2>
          <p>{item[1]}</p>
        </article>
      ))}
    </section>

    <section class="workflow-boundary">
      <p class="workflow-kicker">What it does not mean</p>
      <h2>A protocol family, not a target.</h2>
      <p>
        The lens encodes behavior promises and economic invariants for the family. It carries no
        line numbers and no specific known bug, and it is not tied to any named protocol. It does
        not confirm vulnerabilities, assign final severity, or replace an audit. Human review is
        required. See <code>docs/FIXED_CREDIT_MARKET_LENS.md</code>.
      </p>
      <a href="/docs/protocol-lens-packs" class="workflow-button">Back to Protocol Lens Packs</a>
    </section>
  </main>
</Layout>
