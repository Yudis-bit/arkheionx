---
import Layout from "../../components/Layout.astro";

const groups = [
  {
    label: "Start here",
    links: [
      ["/docs/getting-started", "Getting started", "What Arkheionx is, who it is for, and what to expect."],
      ["/docs/core-workflow", "Core workflow", "The arkheionx review command and the local review pack."],
      ["/docs/cli-reference", "CLI reference", "Every command, flag, and exit code."]
    ]
  },
  {
    label: "Review workflow",
    links: [
      ["/docs/review-workflow", "Review pack", "How a repo becomes scope, value flow, lanes, and tasks."],
      ["/docs/evidence-judge", "Evidence judge", "Grade whether a local test proves its task."],
      ["/docs/report-filter", "Report filter", "Block weak, out-of-scope, or under-proven candidates."]
    ]
  },
  {
    label: "Protocol-aware review",
    links: [
      ["/docs/protocol-lens-packs", "Protocol Lens Packs", "Model a protocol family without making the engine target-specific."],
      ["/docs/fixed-credit-market", "Fixed Credit Market lens", "The first generic protocol-family lens."]
    ]
  },
  {
    label: "Reference",
    links: [
      ["/docs/schemas", "Schemas", "Machine-readable review and manifest artifacts."],
      ["/docs/safety-model", "Safety boundaries", "What Arkheionx does, and what it does not do."],
      ["/releases", "Release notes", "What changed in the current release."]
    ]
  }
];

const archive = [
  ["/docs/concepts", "Concepts"],
  ["/docs/installation", "Installation"],
  ["/docs/quickstart", "Quickstart"],
  ["/docs/determinism", "Determinism"],
  ["/docs/fixture-harness", "Fixture harness"],
  ["/docs/faq", "FAQ"],
  ["/docs/v7-5", "v7.5 Protocol Lens"],
  ["/docs/v7", "v7 Scope orchestration"],
  ["/docs/v6", "v6 Evidence graph"],
  ["/docs/v5", "v5 Blind spots"],
  ["/docs/v4", "v4 Review map"]
];
---

<Layout
  title="Docs — Arkheionx"
  description="Documentation for Arkheionx: the local-first review pack, protocol-aware lenses, schemas, and safety boundaries."
>
  <main class="docs-index">
    <header class="docs-top">
      <p class="kicker">Documentation</p>
      <h1>Start with one local review pack.</h1>
      <p>
        Arkheionx turns a Solidity or DeFi repository into a local review pack: scope, value
        flow, protocol behavior, review lanes, evidence tasks, and a report filter. Human review
        is required.
      </p>
    </header>

    {groups.map((group) => (
      <section class="docs-group">
        <p class="group-label">{group.label}</p>
        <div class="cards">
          {group.links.map(([href, title, body]) => (
            <a class="card" href={href}>
              <h2>{title}</h2>
              <p>{body}</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="docs-archive">
      <p class="group-label">Archive</p>
      <nav aria-label="Archived documentation">
        {archive.map(([href, label]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>
    </section>
  </main>
</Layout>

<style>
  .docs-index {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  .kicker,
  .group-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 14px;
  }

  .docs-top {
    padding: 88px 0 24px;
    max-width: 720px;
  }

  .docs-top h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    font-weight: 600;
  }

  .docs-top p {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .docs-group {
    padding: 36px 0 8px;
    border-top: 1px solid var(--line);
    margin-top: 28px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  .card {
    display: block;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: var(--amber);
    color: var(--text);
    transform: translateY(-2px);
  }

  .card h2 {
    margin: 0 0 8px;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .docs-archive {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .docs-archive nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }

  .docs-archive a {
    color: var(--muted);
    font-size: 0.85rem;
    font-family: var(--mono);
  }

  .docs-archive a:hover {
    color: var(--text);
  }
</style>
