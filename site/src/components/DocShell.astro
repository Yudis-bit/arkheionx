---
const path = Astro.url.pathname;
const sections = [
  {
    label: "Start here",
    links: [
      ["/docs", "Overview"],
      ["/docs/getting-started", "Getting started"],
      ["/docs/installation", "Installation"],
      ["/docs/quickstart", "Quickstart"]
    ]
  },
  {
    label: "Review workflow",
    links: [
      ["/docs/core-workflow", "Core workflow"],
      ["/docs/review-workflow", "Review pack"],
      ["/docs/evidence-judge", "Evidence judge"],
      ["/docs/report-filter", "Report filter"],
      ["/docs/cli-reference", "CLI reference"]
    ]
  },
  {
    label: "Protocol-aware review",
    links: [
      ["/docs/protocol-lens-packs", "Protocol Lens Packs"],
      ["/docs/fixed-credit-market", "Fixed Credit Market lens"]
    ]
  },
  {
    label: "Reference",
    links: [
      ["/docs/concepts", "Concepts"],
      ["/docs/schemas", "Schemas"],
      ["/docs/safety-model", "Safety boundaries"],
      ["/docs/determinism", "Determinism"],
      ["/docs/faq", "FAQ"]
    ]
  },
  {
    label: "Historical",
    links: [
      ["/docs/v7-5", "v7.5 Protocol Lens"],
      ["/docs/v7", "v7 Scope orchestration"],
      ["/docs/v6", "v6 Evidence graph"],
      ["/docs/v5", "v5 Blind spots"],
      ["/docs/v4", "v4 Review map"]
    ]
  }
];
---

<div class="doc-layout page-shell">
  <aside class="doc-sidebar">
    <p class="doc-sidebar-title">Documentation</p>
    {sections.map((section) => (
      <div class="doc-nav-group">
        <p>{section.label}</p>
        <nav aria-label={`${section.label} documentation`}>
          {section.links.map(([href, label]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    ))}
  </aside>
  <article class="doc-content">
    <slot />
  </article>
  <aside class="doc-rail" aria-label="Document status">
    <p>DOCUMENT STATE</p>
    <dl>
      <dt>Surface</dt><dd>Public</dd>
      <dt>Mode</dt><dd>Local/static</dd>
      <dt>Latest stable</dt><dd>v8.0.1</dd>
    </dl>
  </aside>
</div>
