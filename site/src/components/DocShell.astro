---
const path = Astro.url.pathname;
const sections = [
  {
    label: "Start",
    links: [
      ["/docs", "Overview"],
      ["/docs/getting-started", "Getting started"],
      ["/docs/installation", "Installation"],
      ["/docs/quickstart", "Quickstart"]
    ]
  },
  {
    label: "Model",
    links: [
      ["/docs/concepts", "Concepts"],
      ["/docs/safety-model", "Safety model"],
      ["/docs/determinism", "Determinism"],
      ["/docs/fixture-harness", "Fixture harness"]
    ]
  },
  {
    label: "Use",
    links: [
      ["/docs/how-it-works", "How it works"],
      ["/docs/review-workflow", "Review workflow"],
      ["/docs/bug-bounty", "Bug bounty"],
      ["/docs/pre-audit", "Pre-audit"],
      ["/docs/cli-reference", "CLI reference"],
      ["/docs/faq", "FAQ"]
    ]
  },
  {
    label: "Blind spots (v5)",
    links: [
      ["/docs/v5", "V5 overview"],
      ["/docs/blind-spots", "Blind spots"],
      ["/docs/research-pack", "Research pack"],
      ["/docs/research-memory", "Research memory"]
    ]
  },
  {
    label: "Scope orchestration (v7)",
    links: [
      ["/docs/v7", "V7 overview"],
      ["/docs/scope-orchestration", "Scope orchestration"],
      ["/docs/scope-pack", "Scope pack"],
      ["/docs/evidence-judge", "Evidence judge"],
      ["/docs/report-filter", "Report filter"]
    ]
  },
  {
    label: "Release",
    links: [
      ["/docs/v7", "V7 release"],
      ["/docs/v5", "V5 release"],
      ["/docs/v4", "V4 release"]
    ]
  }
];
---

<div class="doc-layout page-shell">
  <aside class="doc-sidebar">
    <p class="doc-sidebar-title">Documentation</p>
    {sections.map((section) => (
      <div class="doc-nav-group">
        <p>{section.label}</p>
        <nav aria-label={`${section.label} documentation`}>
          {section.links.map(([href, label]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    ))}
  </aside>
  <article class="doc-content">
    <slot />
  </article>
  <aside class="doc-rail" aria-label="Document status">
    <p>DOCUMENT STATE</p>
    <dl>
      <dt>Surface</dt><dd>Public</dd>
      <dt>Mode</dt><dd>Local/static</dd>
      <dt>Version</dt><dd>v7.0.0</dd>
    </dl>
  </aside>
</div>
