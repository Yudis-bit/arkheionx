---
const { size = 34, showWordmark = true } = Astro.props;
---

<a class="brand-mark" href="/" aria-label="ArkheionX home">
  <svg class="ark-logo" width={size} height={size} viewBox="0 0 64 64" role="img" aria-label="ArkheionX logo">
    <defs>
      <linearGradient id="ark-logo-gradient" x1="11" y1="55" x2="53" y2="8" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#13d6f2" />
        <stop offset="0.48" stop-color="#6fffe9" />
        <stop offset="1" stop-color="#7aa2f7" />
      </linearGradient>
      <filter id="ark-logo-glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="2.4" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.05 0 0 0 0 0.85 0 0 0 0 1 0 0 0 0.65 0" />
        <feMerge>
          <feMergeNode />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
    <path d="M32 4 58 56H43L32 33 21 56H6L32 4Z" fill="url(#ark-logo-gradient)" opacity="0.18" filter="url(#ark-logo-glow)" />
    <path d="M32 4 58 56H44.5L32 31.6 19.5 56H6L32 4Z" fill="url(#ark-logo-gradient)" />
    <path d="M32 20.5 43.5 45.5 32 39.2 21 45.5 32 20.5Z" fill="#071018" opacity="0.96" />
    <path d="M32 31.3 39.4 47.5 32 43.8 24.8 47.5 32 31.3Z" fill="#0dd7f2" opacity="0.72" />
  </svg>

  {showWordmark && (
    <span class="brand-copy">
      <span class="brand-name">ArkheionX</span>
      <span class="brand-sub">LOCAL REVIEW INFRASTRUCTURE</span>
    </span>
  )}
</a>
