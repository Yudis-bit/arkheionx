  "contractName": "GenericCoreWallet",
  "sourcePath": "contracts/GenericCoreWallet.sol",
  "source": "pragma solidity ^0.8.20;\n\ncontract GenericCoreWallet {\n    address public owner;\n    uint256 public sequence;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    function execute(address destination, uint256 value, bytes calldata data) external {\n        require(msg.sender == owner, \"owner\");\n        sequence += 1;\n        (bool ok,) = destination.call{value: value}(data);\n        require(ok, \"call\");\n    }\n}\n",
